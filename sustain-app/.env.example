# Server-side only. Never prefix with NEXT_PUBLIC_.
ZOO_MODE=fake                  # fake = scripted agents, no cost. real = ZooWork agents.
DEMO_TODAY=2026-11-07
BALANCE_FLOOR_USD=20
RUN_COST_LIMIT_USD=3
DATABASE_URL=file:local.db     # Vercel: use a Turso URL (libsql://...) because serverless disks are not persistent
DATABASE_AUTH_TOKEN=
# real mode only
ZOOWORK_API_KEY=zwp_live_REPLACE
ZOOWORK_BASE_URL=https://clawapi.ecap.gsmo.ai/service/v1
ZOOWORK_WEBHOOK_SECRET=whsec_REPLACE
INTAKE_AGENT_ID=
DISPOSITION_AGENT_ID=
# Local live demo only. Serve ZooWork pickup files through the loopback app.
ENABLE_ZOOWORK_ARTIFACT_DOWNLOAD=0
# Supply the app-calculated plan to the model for the isolated demo.
DISPOSITION_DEMO_PLAN=0
# Exact origin of the team UI when it is hosted separately.
TEXTILE_UI_ORIGIN=
